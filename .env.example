# copy to .env and `set -a; . ./.env; set +a` before running uvicorn
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000
ANTHROPIC_API_KEY=            # enables the Claude fix plan (Pro+ reports and the CLI)
LEAKPROOF_CLAUDE_MODEL=claude-opus-5-5
STRIPE_SECRET_KEY=            # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (endpoint: /billing/webhook, event customer.subscription.*)
STRIPE_PRICE_PRO=             # price_... $29/mo
STRIPE_PRICE_PRO_YEAR=        # price_... $290/yr
STRIPE_PRICE_TEAM=            # price_... $99/mo
DATABASE_URL=                 # blank = SQLite in ./data; or postgresql://...
LEAKPROOF_WORKERS=2

# --- payments: set ONE provider. Lemon Squeezy is a merchant of record (handles global tax, pays out to India).
LEMON_CHECKOUT_PRO=           # https://<store>.lemonsqueezy.com/checkout/buy/<variant-uuid>  ($29/mo)
LEMON_CHECKOUT_PRO_YEAR=      # same for $290/yr
LEMON_CHECKOUT_TEAM=          # same for $99/mo
LEMON_WEBHOOK_SECRET=         # signing secret of the webhook pointed at https://<your-domain>/billing/lemon-webhook
LEMON_STORE_URL=              # https://<store>.lemonsqueezy.com  (customer portal fallback)
LEMON_VARIANTS=               # optional "variantid:pro,variantid:team" if custom data is ever missing
